---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import PageShell from '../components/ui/PageShell.astro';
const title = 'Закладки и коллекции — сохранённые аяты';
const description =
  'Ваши закладки Корана с группировкой по именованным коллекциям: соберите аяты по темам (для заучивания, дуа, важное) — всё на этом устройстве, без входа.';
---

<Base {title} {description}>
  <PageShell class="bmp" narrow data-bmp>
    <PageHeader
      class="bmp-head"
      title="Закладки"
      description="Сохранённые аяты. Группируйте их в коллекции по темам."
    >
      <form class="bmp-new" data-new-form>
        <input type="text" placeholder="Новая коллекция…" data-new-name maxlength="40" aria-label="Название коллекции" />
        <Button type="submit" variant="primary">Создать</Button>
      </form>
    </PageHeader>

    <div class="bmp-body" data-body>
      <p class="bmp-empty" data-loading>Загрузка…</p>
    </div>

    <section class="bmp-col" data-mushaf-bmp hidden>
      <div class="bmp-col-h"><h2>Страницы мусхафа</h2><span class="cnt" data-mushaf-bmp-count></span></div>
      <div class="bmp-items" data-mushaf-bmp-list></div>
    </section>
  </PageShell>
</Base>

<script>
  import { loadMeta } from '../client/mushaf-data';
  import { getPageBookmarks, removePageBookmark } from '../client/mushaf-store';

  // закладки страниц из режима мусхафа (кнопка-закладка в его тулбаре)
  const box = document.querySelector<HTMLElement>('[data-mushaf-bmp]');
  const list = document.querySelector<HTMLElement>('[data-mushaf-bmp-list]');
  const count = document.querySelector('[data-mushaf-bmp-count]');
  const fmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'short' });

  async function renderMushafBookmarks() {
    const marks = getPageBookmarks();
    if (!box || !list) return;
    box.hidden = !marks.length;
    if (count) count.textContent = String(marks.length);
    let surahs: { n: number; nr: string; p: number }[] = [];
    try {
      surahs = (await loadMeta()).suraPages;
    } catch {}
    list.replaceChildren(
      ...marks.map((b) => {
        const s = surahs.filter((x) => x.p <= b.p).pop();
        const row = document.createElement('div');
        row.className = 'bmp-item ui-card';
        const ref = document.createElement('a');
        ref.className = 'ref';
        ref.href = `/mushaf/${b.p}`;
        ref.textContent = `стр. ${b.p}`;
        const nm = document.createElement('span');
        nm.className = 'nm';
        nm.textContent = `${s ? s.nr + ' · ' : ''}${fmt.format(b.t)}`;
        const rm = document.createElement('button');
        rm.className = 'rm ui-icon-button';
        rm.textContent = '✕';
        rm.title = 'Убрать закладку';
        rm.setAttribute('aria-label', `Убрать закладку со страницы ${b.p}`);
        rm.addEventListener('click', () => {
          removePageBookmark(b.p);
          renderMushafBookmarks();
        });
        row.append(ref, nm, rm);
        return row;
      })
    );
  }
  renderMushafBookmarks();
</script>

<script is:inline>
  (function () {
    var KB = 'q_bookmarks',
      KC = 'q_collections',
      KM = 'q_bmcol';
    var body = document.querySelector('[data-body]');
    function get(k, d) {
      try {
        var v = localStorage.getItem(k);
        return v == null ? d : JSON.parse(v);
      } catch (e) {
        return d;
      }
    }
    function set(k, v) {
      try {
        localStorage.setItem(k, JSON.stringify(v));
      } catch (e) {}
    }
    var bms = get(KB, []); // ["s:a"]
    var cols = get(KC, []); // ["Название", ...]
    var map = get(KM, {}); // {"s:a": "Название"|""}
    var names = {};

    fetch('/data/index.json?v=5')
      .then(function (r) {
        return r.json();
      })
      .then(function (idx) {
        idx.forEach(function (s) {
          names[s.n] = s.nr;
        });
        render();
      })
      .catch(function () {
        render();
      });

    document.querySelector('[data-new-form]').addEventListener('submit', function (e) {
      e.preventDefault();
      var inp = document.querySelector('[data-new-name]');
      var n = (inp.value || '').trim();
      if (!n || cols.indexOf(n) !== -1) {
        inp.value = '';
        return;
      }
      cols.push(n);
      set(KC, cols);
      inp.value = '';
      render();
    });

    function optionsHtml(cur) {
      var o = '<option value="">Без коллекции</option>';
      cols.forEach(function (c) {
        o += '<option value="' + esc(c) + '"' + (c === cur ? ' selected' : '') + '>' + esc(c) + '</option>';
      });
      return o;
    }
    function esc(s) {
      return String(s).replace(/[&<>"]/g, function (m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m];
      });
    }

    function render() {
      if (!bms.length) {
        body.innerHTML =
          '<p class="bmp-empty">Пока нет закладок. Откройте аят и нажмите на «флажок».</p>';
        return;
      }
      // группируем
      var groups = { '': [] };
      cols.forEach(function (c) {
        groups[c] = [];
      });
      bms.forEach(function (key) {
        var c = map[key] || '';
        if (!(c in groups)) c = '';
        groups[c].push(key);
      });
      var order = cols.slice();
      order.push(''); // «без коллекции» — в конце
      var html = '';
      order.forEach(function (c) {
        var items = groups[c] || [];
        if (c === '' && !items.length) return;
        html +=
          '<section class="bmp-col"><div class="bmp-col-h"><h2>' +
          (c ? esc(c) : 'Без коллекции') +
          '</h2><span class="cnt">' +
          items.length +
          '</span>' +
          (c ? '<button class="del ui-button ghost" data-del-col="' + esc(c) + '">Удалить коллекцию</button>' : '') +
          '</div><div class="bmp-items">';
        if (!items.length) html += '<p class="bmp-empty is-compact">Пусто</p>';
        items.forEach(function (key) {
          var sp = key.split(':');
          var nm = (names[+sp[0]] || 'Сура ' + sp[0]) + ' · аят ' + sp[1];
          html +=
            '<div class="bmp-item ui-card"><a class="ref" href="/' +
            key +
            '">' +
            key +
            '</a><span class="nm">' +
            esc(nm) +
            '</span><select data-move="' +
            key +
            '">' +
            optionsHtml(map[key] || '') +
            '</select><button class="rm ui-icon-button" data-rm="' +
            key +
            '" title="Убрать из закладок" aria-label="Убрать">✕</button></div>';
        });
        html += '</div></section>';
      });
      body.innerHTML = html;
    }

    body.addEventListener('change', function (e) {
      var sel = e.target.closest('[data-move]');
      if (!sel) return;
      map[sel.getAttribute('data-move')] = sel.value;
      set(KM, map);
      render();
    });
    body.addEventListener('click', function (e) {
      var rm = e.target.closest('[data-rm]');
      if (rm) {
        var key = rm.getAttribute('data-rm');
        bms = bms.filter(function (k) {
          return k !== key;
        });
        delete map[key];
        set(KB, bms);
        set(KM, map);
        render();
        return;
      }
      var dc = e.target.closest('[data-del-col]');
      if (dc) {
        var name = dc.getAttribute('data-del-col');
        if (!confirm('Удалить коллекцию «' + name + '»? Закладки останутся (перейдут в «Без коллекции»).')) return;
        cols = cols.filter(function (c) {
          return c !== name;
        });
        for (var k in map) if (map[k] === name) map[k] = '';
        set(KC, cols);
        set(KM, map);
        render();
      }
    });
  })();
</script>
